# Copiar como .env en la raiz del proyecto. No se carga automaticamente con java -jar.
# Sustituir servidor.tailxxxx.ts.net por el DNSName real de Tailscale, sin https:// ni /.
# Mantener localhost para el lanzador. Para uso solo local, omitir los dos hosts remotos.
PAPELERIA_ALLOWED_HOSTS=localhost:8080,127.0.0.1:8080,servidor.tailxxxx.ts.net,servidor.tailxxxx.ts.net:443

# Opcionales: descomentar solo si se necesitan. Rutas absolutas; sin expansion de %VARIABLES%.
# PAPELERIA_DB=C:\Papeleria\datos\papeleria.db
# PAPELERIA_NO_BROWSER=1

# Formato: NOMBRE=valor, comillas exteriores opcionales. Comentarios en lineas separadas.
# No se expanden variables ni se ejecutan comandos. Variables de Windows tienen prioridad.
